/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/terms.html
  Cache-Control: public, max-age=3600

/privacy.html
  Cache-Control: public, max-age=3600

/guidelines.html
  Cache-Control: public, max-age=3600

/404.html
  Cache-Control: public, max-age=3600

/css/*
  Cache-Control: public, max-age=3600

/js/*
  Cache-Control: public, max-age=3600

/js/vendor/*
  Cache-Control: public, max-age=604800

/assets/*
  Cache-Control: public, max-age=86400
